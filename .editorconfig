root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,h,rc}]
indent_style = space
indent_size = 4

[*.{sln,vcxproj,vcxproj.filters,vcproj}]
indent_style = space
indent_size = 2
charset = utf-8

[README.md]
trim_trailing_whitespace = false